{
    "name": "phox/typesafe-sdk-php",
    "description": "A PHP SDK for the TypeSafe AI API, direct or through OpenRouter",
    "type": "library",
    "license": "MIT",
    "keywords": ["typesafe", "sdk", "ai", "classification", "llm", "openrouter"],
    "homepage": "https://github.com/Fox-Islam/typesafe-sdk-php",
    "authors": [
        {
            "name": "Fox Islam",
            "email": "foxislam@outlook.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Phox\\TypeSafe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phox\\TypeSafe\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
